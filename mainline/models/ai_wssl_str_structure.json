{
  "architecture_version": "phase8_activity_interaction_v1",
  "backbone_model": {
    "input_channels": 6,
    "num_classes": 2,
    "sample_rate": 100.0,
    "frequency": {
      "bands": [
        [
          0.5,
          3.0
        ],
        [
          3.0,
          7.0
        ],
        [
          7.0,
          12.0
        ]
      ],
      "boundary": "half_open",
      "include_last_high": true,
      "include_original": false
    },
    "encoder": {
      "branch_channels": 64,
      "hidden_dim": 128,
      "kernel_size": 3,
      "dilations": [
        1,
        2,
        4
      ],
      "channel_reduction": 8,
      "conv_bias": false,
      "dropout": 0.0
    },
    "mil": {
      "window_seconds": 1.0,
      "overlap": 0.5,
      "attention_dim": null,
      "retention_ratio": 0.3,
      "epsilon": 1e-08,
      "hard_gating": true,
      "hard_gating_train_only": false,
      "attention_type": "tanh"
    },
    "activity_fusion": {
      "attention_dim": 64,
      "dropout": 0.1,
      "classifier_dropout": 0.2,
      "mode": "attention"
    },
    "pure_deep": {
      "feature_dim": 64,
      "dropout": 0.1,
      "pooling": "attention_mean_std",
      "stem_mode": "shared",
      "temporal": {
        "kernel_size": 7,
        "dilations": [
          1,
          2,
          4
        ],
        "normalization": "group_norm",
        "normalization_groups": 8
      },
      "spectral": {
        "enabled": false
      },
      "moment_branch": {
        "enabled": true,
        "feature_dim": 32,
        "kernels": [
          1,
          15,
          63
        ]
      }
    },
    "structured_token_residual": {
      "enabled": true,
      "projection_dim": 16
    }
  },
  "data_structure": {
    "activities": [
      "CrossArms",
      "DrinkGlas",
      "Entrainment",
      "HoldWeight",
      "LiftHold",
      "PointFinger",
      "Relaxed",
      "RelaxedTask",
      "StretchHold",
      "TouchIndex",
      "TouchNose"
    ],
    "wrist_mode": "bilateral",
    "sensor_mode": "acc_gyro",
    "wrist_order": [
      "left",
      "right"
    ],
    "channel_names": [
      "AccX",
      "AccY",
      "AccZ",
      "GyroX",
      "GyroY",
      "GyroZ"
    ],
    "raw_input_channels": 6
  },
  "interaction": {
    "token_dim": 258,
    "projection_dim": 64,
    "activities": 11,
    "heads": 4,
    "layers": 1,
    "ffn_hidden_dim": 128,
    "dropout": 0.1,
    "output_dim": 258,
    "output_init": "zeros",
    "residual_bias": false
  }
}
